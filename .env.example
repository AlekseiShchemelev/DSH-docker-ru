# ========================================================
# Шаблон файла переменных окружения deepseek-harness-docker
# ========================================================

# Код доступа (Access Code)
# Вводится при доступе в браузере к DSH Web, /admin панели управления и /vnc рабочему столу
# Оставить пустым (рекомендуется): при первом заходе откроется страница «Настройка кода доступа»,
#                только после неё интерфейс заработает;
#                код будет сохранён на том данных с правами 0600 и останется после перезапуска контейнера.
# Заполнить явно: начальная страница настроек пропускается, используется этот код доступа
#                (не используйте слабые пароли вроде admin).
AUTH_TOKEN=

# Ключ подписи сессий Session (необязательно)
# По умолчанию при первом старте автоматически генерируется 256-битный стойкий случайный ключ
# и сохраняется на том данных (/root/.dsh/.session_secret)
# Для общего пула сессий между машинами или ручного задания раскомментируйте и задайте здесь
# SESSION_SECRET=your_custom_long_random_secret_here

# Единый внешний порт прокси (по умолчанию 3080)
# Примечание: при явном задании он **имеет приоритет** над сохранённой конфигурацией тома (M13)
#            и одновременно определяет маппинг порта хоста в compose;
#            если пусто/не задано — используется 3080.
PROXY_PORT=3080

# Доверять ли X-Forwarded-For от обратного прокси (по умолчанию 0)
# Только когда шлюз реально стоит за доверенным обратным прокси (Nginx/Traefik и т.п.) ставить 1,
# иначе любой сможет подделать XFF и обойти ограничение частоты входа (M1).
# TRUST_PROXY=0

# Белый список внешних имён хоста (через запятую, для same-origin проверки WebSocket)
# Например: PUBLIC_HOST=dsh.example.com
# PUBLIC_HOST=

# --- Следующие опции необязательны, по умолчанию закомментированы: ---
# ADMIN_PATH=/admin
# VNC_PATH=/vnc
# DSH_WORKSPACE=/workspace
# DSH_DESKTOP_ENABLED=1
# DSH_IDLE_TIMEOUT_MINUTES=30
# DSH_DESKTOP_WIDTH=1920
# DSH_DESKTOP_HEIGHT=1080
# DSH_SCREENSHOT_QUALITY=high          # Качество скриншотов ИИ по умолчанию (high/medium/low, по умолчанию high)
# DSH_SCREENSHOT_DIR=                  # Подкаталог сохранения скриншотов ИИ по умолчанию
                                       # (относительно рабочей области; пусто = корень)

# ─────────────────────────────────────────────────────────────
# Исходящий сетевой прокси (необязательно: для модельных API, веб-поиска или загрузки плагинов)
# DSH официально с 0.1.5-rc.1 полностью следует нативным настройкам исходящего прокси
# ─────────────────────────────────────────────────────────────
# HTTP_PROXY=http://172.17.0.1:7890
# HTTPS_PROXY=http://172.17.0.1:7890
# ALL_PROXY=socks5://172.17.0.1:7890
# NO_PROXY=localhost,127.0.0.1,dsh